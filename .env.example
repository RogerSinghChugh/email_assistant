# Copy to .env and fill in. Do not commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ENV=dev
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# sqlite default; set to postgres://user:pass@host:5432/db for Postgres.
DATABASE_URL=sqlite:///db.sqlite3

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# --- Encryption ---
# Comma-separated list of salt strings, newest first.
# Encryption keys are derived via PBKDF2-HMAC-SHA256 from DJANGO_SECRET_KEY salted with each salt.
# Pick any high-entropy string (32+ chars). Rotate by prepending a new value to the list.
SALT_KEYS=

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.0-flash-001
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=3

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
